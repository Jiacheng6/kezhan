{
  "name": "kebo",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "课栈：软件内网页、多平台课程管理与 AI 辅助",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:service": "node src/main.mjs",
    "preview:ui": "node tools/preview/workspace.mjs",
    "preview:selection": "node tools/preview/workspace.mjs --selection",
    "preview:embedded": "node tools/preview/embedded.mjs",
    "build:native": "node tools/build/build-native.mjs",
    "build:archive": "node tools/build/build-course-archive.mjs",
    "build": "npm run build:archive && node tools/build/build-native.mjs && electron-builder --win nsis zip --x64 --publish never",
    "test": "node tools/test/test-offline.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "electron-updater": "6.8.9",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "releaseInfo": {
      "releaseNotesFile": "docs/releases/0.9.1.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jiacheng6",
        "repo": "kezhan-releases"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "appId": "com.kebo.app",
    "productName": "课栈",
    "copyright": "课栈",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "src/**/*",
      "desktop/*.cjs",
      "desktop/loading.html",
      "desktop/loading.js",
      "desktop/assets/*",
      "desktop/native/*.exe",
      "使用说明.md",
      "package.json",
      "!**/*.map",
      "!**/test{,s}/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "executableName": "课栈",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kezhan-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "guid": "498a0d80-d4f9-5e0f-b76b-f2eb2460b8bc",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kezhan-${version}-Setup.${ext}",
      "include": "desktop/installer.nsh"
    }
  },
  "license": "GPL-3.0-only"
}
