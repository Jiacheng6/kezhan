{
  "name": "xuexitong-auto",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "description": "学习通桌面助手：软件内网页、课程管理与网页版 AI 辅助",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:service": "node src/main.mjs",
    "preview:ui": "node tools/preview/workspace.mjs",
    "preview:selection": "node tools/preview/workspace.mjs --selection",
    "preview:embedded": "node tools/preview/embedded.mjs",
    "build:native": "node tools/build/build-native.mjs",
    "build:archive": "node tools/build/build-course-archive.mjs",
    "build": "npm run build:archive && node tools/build/build-native.mjs && electron-builder --win nsis zip --x64 --publish never",
    "test": "node tools/test/test-offline.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "releaseInfo": {
      "releaseNotesFile": "docs/releases/0.5.6.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jiacheng6",
        "repo": "xuexitong-assistant-releases"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "appId": "com.xuexitong.assistant",
    "productName": "学习通助手",
    "copyright": "学习通助手",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "src/**/*",
      "desktop/*.cjs",
      "desktop/loading.html",
      "desktop/loading.js",
      "desktop/assets/*",
      "desktop/native/*.exe",
      "使用说明.md",
      "package.json",
      "!**/*.map",
      "!**/test{,s}/**"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "executableName": "学习通助手",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "XuexitongAssistant-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "XuexitongAssistant-${version}-Setup.${ext}"
    }
  }
}
